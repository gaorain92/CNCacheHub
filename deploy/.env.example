# CNCacheHub 生产环境变量样例
# 复制为 .env 并填入实际值

# === 必填 ===
# 管理员初始密码（首次登录后必须改）
ADMIN_PASSWORD=change-me-please-123

# 公网域名（用于 HTTPS 证书申请）
PUBLIC_DOMAIN=cache.example.com

# 管理员邮箱（Let's Encrypt 证书通知）
ADMIN_EMAIL=admin@example.com

# === 可选 ===

# 数据持久化目录（容器内挂载点）
DATA_DIR=/var/lib/cncachehub

# 缓存目录
CACHE_DIR=/var/lib/cncachehub/cache

# 日志目录
LOG_DIR=/var/log/cncachehub

# 服务监听端口（容器内）
SERVER_PORT=8080
WEB_PORT=80

# 是否开启小容量 VPS 优化（true/false）
SMALL_VPS_OPT=false

# 系统保底空间（GB）
RESERVE_SPACE_GB=5

# 单对象落盘上限（MB）
MAX_OBJECT_SIZE_MB=1024

# 缓存总上限（GB，0 表示不限制）
CACHE_TOTAL_GB=20

# 时区
TZ=Asia/Shanghai
